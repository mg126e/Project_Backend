{
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "lib": ["deno.window", "deno.ns", "deno.unstable"]
    },
    "imports": {
        "@concepts/": "./src/concepts/",
        "@concepts": "./src/concepts/concepts.ts",
        "@deps/mongo": "./src/deps/mongo.ts",
        "@hono/hono": "jsr:@hono/hono@^4.10.6",
        "@std/assert": "jsr:@std/assert@^1.0.16",
        "@std/cli": "jsr:@std/cli@^1.0.24",
        "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
        "@std/fs": "jsr:@std/fs@^1.0.20",
        "@std/media-types": "jsr:@std/media-types@^1.1.0",
        "@std/path": "jsr:@std/path@1.1.3",
        "@test-concepts": "./src/concepts/test_concepts.ts",
        "@utils/": "./src/utils/",
        "@engine": "./src/engine/mod.ts",
        "@syncs": "./src/syncs/syncs.ts",
        "mime-types": "npm:mime-types@^3.0.2",
        "google-auth-library": "npm:google-auth-library@^9"
    },
    "tasks": {
        "start": "deno run --allow-net --allow-write --allow-read --allow-sys --allow-env --node-modules-dir=auto --unstable src/main.ts",
        "concepts": "deno run --allow-net --allow-read --allow-sys --allow-env src/concept_server.ts --port 8000 --baseUrl /api",
        "import": "deno run --allow-read --allow-write --allow-env src/utils/generate_imports.ts",
        "build": "deno run import"
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-import-prefix",
                "no-unversioned-import"
            ]
        }
    }
}